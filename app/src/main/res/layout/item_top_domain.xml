<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_badge"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Rank badge -->
    <TextView
        android:id="@+id/tv_domain_rank"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Domain text -->
    <TextView
        android:id="@+id/tv_domain_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:text="analytics.google.com"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Count badge -->
    <TextView
        android:id="@+id/tv_domain_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_unselected"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="42 hits"
        android:textColor="@color/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Quick action button -->
    <Button
        android:id="@+id/btn_quick_action"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:minWidth="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Block"
        android:textColor="@color/colorBlocked"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
