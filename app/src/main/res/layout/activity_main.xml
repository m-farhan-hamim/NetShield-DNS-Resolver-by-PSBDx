<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bg_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="App Logo"
            android:src="@drawable/ic_shield" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_header_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_stopped"
                android:textColor="@color/colorBlocked"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:id="@+id/indicator_status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/colorBlocked" />

    </LinearLayout>

    <!-- Notification permission banner (shown only if permission denied) -->
    <LinearLayout
        android:id="@+id/banner_notification_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBlocked"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notification_permission_banner"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_enable_notifications"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_enable"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Update-available banner (GitHub-distributed installs only; see UpdateChecker) -->
    <LinearLayout
        android:id="@+id/banner_update_available"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_update_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            tools:text="New version v1.2.0 is available" />

        <Button
            android:id="@+id/btn_update_now"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_update"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Navigation TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bg_surface"
        app:tabIndicatorColor="@color/colorPrimary"
        app:tabIndicatorHeight="3dp"
        app:tabMode="auto"
        app:tabRippleColor="@color/surface_variant"
        app:tabSelectedTextColor="@color/colorPrimary"
        app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Tab"
        app:tabTextColor="@color/text_secondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_shield"
            android:text="@string/tab_dashboard" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_traffic"
            android:text="@string/tab_traffic" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_logs"
            android:text="@string/tab_logs" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_rules"
            android:text="@string/tab_rules" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_settings"
            android:text="@string/tab_settings" />

    </com.google.android.material.tabs.TabLayout>

    <!-- View Content Containers -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/container_dashboard"
            layout="@layout/view_dashboard"
            android:visibility="visible" />

        <include
            android:id="@+id/container_traffic"
            layout="@layout/view_traffic"
            android:visibility="gone" />

        <include
            android:id="@+id/container_logs"
            layout="@layout/view_logs"
            android:visibility="gone" />

        <include
            android:id="@+id/container_rules"
            layout="@layout/view_rules"
            android:visibility="gone" />

        <include
            android:id="@+id/container_settings"
            layout="@layout/view_settings"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
