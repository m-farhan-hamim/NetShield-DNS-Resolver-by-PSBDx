<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Animated "breathing" ring behind the logo (see SplashActivity) -->
    <View
        android:id="@+id/view_pulse_ring"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/bg_splash_ring" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_splash_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:alpha="0"
            android:contentDescription="@string/app_name"
            android:scaleX="0.4"
            android:scaleY="0.4"
            android:src="@drawable/ic_shield"
            android:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/tv_splash_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:alpha="0"
            android:letterSpacing="0.03"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0"
            android:text="@string/splash_tagline"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_powered_by"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:alpha="0"
        android:letterSpacing="0.06"
        android:text="@string/splash_powered_by"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

</FrameLayout>
