    <!-- Hotspot tab -->
    <string name="tab_hotspot">HOTSPOT</string>
    <string name="hotspot_disclaimer_title">What this tab can and can\'t do</string>
    <string name="hotspot_disclaimer_body">Android does not let a normal installed app turn the system hotspot on/off, list or kick specific hotspot clients, or measure a device\'s data usage in MB/GB - those need system-level permissions this app can\'t have. What IS real here: any device that sets this phone as its DNS server (Wi-Fi or hotspot) gets the same block/allow lists as this phone, and this screen can block or daily-limit that device\'s DNS queries specifically.</string>
    <string name="hotspot_status_title">This phone\'s address</string>
    <string name="hotspot_local_address_hint">On another device connected to this phone\'s Wi-Fi/hotspot, set its DNS server to this address to filter it with the same rules as this phone.</string>
