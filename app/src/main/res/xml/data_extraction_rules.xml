<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Proxy subscription URLs embed a secret token: never back them up. -->
        <exclude domain="sharedpref" path="proxy_subscriptions.xml" />
        <exclude domain="sharedpref" path="proxy_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="proxy_subscriptions.xml" />
        <exclude domain="sharedpref" path="proxy_settings.xml" />
    </device-transfer>
</data-extraction-rules>
